# Backend Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_here_change_in_production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/lens_ai

# AWS Configuration (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=lens-ai-images

# Camera SDK Configuration
CANON_SDK_PATH=/path/to/canon/sdk
SONY_API_KEY=your_sony_api_key
NIKON_SDK_PATH=/path/to/nikon/sdk

# AI/ML Configuration
TENSORFLOW_MODEL_PATH=./ai/models/scene_classifier.tflite
PYTHON_PATH=/usr/bin/python3

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Development Tools
ENABLE_CORS=true
ENABLE_SWAGGER=true

# Mobile App Configuration
API_BASE_URL=http://localhost:3000/api
WEBSOCKET_URL=ws://localhost:3001

# Image Processing
MAX_IMAGE_SIZE=10485760
SUPPORTED_FORMATS=jpg,jpeg,png,tiff,raw,cr3,nef,arw

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000